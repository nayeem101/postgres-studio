{
  "name": "postgres-studio",
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "bun-types": "^1.4.0",
    "happy-dom": "^20.11.6",
    "typescript": "^7.0.2"
  },
  "private": true,
  "scripts": {
    "dev": "bun run --filter @pg-studio/server --filter @pg-studio/web dev",
    "dev:server": "bun run --filter @pg-studio/server dev",
    "dev:web": "bun run --filter @pg-studio/web dev",
    "test": "bun test tests/unit tests/integration",
    "test:web": "bun test --preload ./tests/setup/happydom.ts apps/web",
    "build:web": "bun run --filter @pg-studio/web build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p tests/tsconfig.json",
    "seed:test-db": "bun apps/server/src/seed.ts"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
