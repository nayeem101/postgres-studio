{
  "name": "postgres-studio",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter @pg-studio/server --filter @pg-studio/web dev",
    "dev:server": "bun run --filter @pg-studio/server dev",
    "dev:web": "bun run --filter @pg-studio/web dev",
    "test": "bun test tests/unit tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium",
    "typecheck": "bun run --filter '*' typecheck",
    "seed:test-db": "bun apps/server/src/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "bun-types": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
